# Server
JWT_SECRET=your_jwt_secret
MONGODB_URI=mongodb://localhost:27017/horizon

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CURRENCY=zar

# Client (copy publishable key here too for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Frontend URL used in password-reset emails (the Next.js app, not the API)
FRONTEND_URL=http://localhost:3000

# Gmail (or SMTP) for forgot-password emails. Use an app password, not the account password.
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your_app_password
